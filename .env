# Environment variables for tec-suite
# Path on the host where the RINEX data root is stored (host path)
# Example for Windows host: Y:/data
RINEX_DATA_PATH_HOST=F:/MyData/ND/Server

# Path inside the container where the host RINEX root will be mounted
# Default container mount point used by docker-compose and examples below
RINEX_DATA_PATH=/data/rinex

# When running locally (not via docker) you can instead set RINEX_DATA_PATH
# to the absolute host path (for example: Y:/data) so process_rinex.py resolves
# relative paths against it.
# RINEX_DATA_PATH=Y:/data
## Output (data) path variables
# Host path where TECS output should be stored (host filesystem)
# Example for Windows host: N:/RINEX
DAT_DATA_PATH_HOST=N:/RINEX/out

# Path inside the container where the host output root will be mounted
# Default container path used by docker-compose and examples below
DAT_DATA_PATH=/app/out
